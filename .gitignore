# Obsidian system files
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/plugins/*/data.json

# Claude local config (personal paths — each user keeps their own)
.claude/knowledge-base.local.md
.claude/settings.local.json

# Temp files
temp-starter/

# Top-level cache contents (keep the folder, ignore contents)
cache/*
!cache/.gitkeep

# Node
node_modules/

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# Environment / secrets
.env
credentials*.json
